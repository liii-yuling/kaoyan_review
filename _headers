/*
  X-Content-Type-Options: nosniff

/index.html
  Cache-Control: no-cache, must-revalidate

/version.json
  Cache-Control: no-store, no-cache, must-revalidate

/src/version.js
  Cache-Control: no-store, no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/src/*
  Cache-Control: public, max-age=31536000, immutable
